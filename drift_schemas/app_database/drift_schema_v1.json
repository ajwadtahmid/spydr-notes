  "fixed_sql": [
    {
      "name": "folders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"folders\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"parent_folder_id\" TEXT NULL REFERENCES folders (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notes\" (\"row_id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"id\" TEXT NOT NULL UNIQUE, \"title\" TEXT NOT NULL, \"content\" TEXT NOT NULL DEFAULT '', \"folder_id\" TEXT NULL REFERENCES folders (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"last_opened_at\" INTEGER NULL, \"is_pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_pinned\" IN (0, 1)), \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"deleted_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL UNIQUE, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "note_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"note_tags\" (\"note_id\" TEXT NOT NULL REFERENCES notes (id) ON DELETE CASCADE, \"tag_id\" TEXT NOT NULL REFERENCES tags (id) ON DELETE CASCADE, PRIMARY KEY (\"note_id\", \"tag_id\"));"
        }
      ]
    },
    {
      "name": "note_links",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"note_links\" (\"source_note_id\" TEXT NOT NULL REFERENCES notes (id) ON DELETE CASCADE, \"occurrence_index\" INTEGER NOT NULL, \"target_note_id\" TEXT NULL REFERENCES notes (id) ON DELETE SET NULL, \"target_id_text\" TEXT NULL, \"raw_title\" TEXT NOT NULL, \"link_type\" TEXT NULL, PRIMARY KEY (\"source_note_id\", \"occurrence_index\"));"
        }
      ]
    },
    {
      "name": "search_queries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"search_queries\" (\"query\" TEXT NOT NULL, \"searched_at\" INTEGER NOT NULL, PRIMARY KEY (\"query\"));"
        }
      ]
    },
    {
      "name": "app_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_preferences\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
